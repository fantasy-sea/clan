<full-backup-content>
    <!-- DataStore Preferences 位于 files/datastore/；不能把设备凭证备份到另一台手机。 -->
    <exclude domain="file" path="datastore/device_credentials.preferences_pb" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
